# =============================================================================
# .env.sverk — конфигурация для РЕАЛЬНЫХ дронов (make city-sverk)
# =============================================================================
# Заполни актуальные IP своих дронов и ровера.
# SSH-доступ по ключу обязателен: ssh-copy-id pi@<ip>
# =============================================================================

# =========================== Хосты дронов (Raspberry Pi) =====================
DRONE1_HOST=192.168.1.116
DRONE2_HOST=192.168.1.111
DRONE3_HOST=192.168.1.110
DRONE4_HOST=192.168.1.124
DRONE_USER=sverk
DRONE_REPO_DIR=/home/sverk/stress_test_drone_city


# =========================== Ровер ===========================================
ROVER_API_URL=http://192.168.1.201:8767

# =========================== LLM (Sverk AI) ==================================
MODEL_PROVIDER=sverk
MODEL=gemma4-vlm
SVERK_API_KEY=sk-jkx31e2PLKxCpjOynEwyxA
SVERK_API_BASE=https://ai.sverk.tech/v1
MODEL_VISION=gemma4-vlm

# =========================== Сценарий ========================================
SCENARIO=city-1
TASK=city_missions

# =========================== Параметры поля ===================================
CELL_SIZE_M=0.8
FIELD_ORIGIN_X=-2.0
FIELD_ORIGIN_Y=-2.0
BODY_TAKEOFF=2.0
ARUCO_LOCK_SEC=18
OBSERVER_HOVER_SEC=20

# =========================== Хаб =============================================
# IP центрального ПК (где запускается coordinator + hub)
# Порт 8095 — внешний порт хаба (проброшен из Docker)
HUB_URL=http://192.168.1.75:8095
HUB_HOST=192.168.1.75
VIZ_HOST_PORT=8095

# =========================== Дедлайны (сек) ===================================
# Через сколько секунд прерывается обсуждение и принимается вердикт
DEADLINE_CHAT=120