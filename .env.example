# .env.example — скопировать в .env и заполнить ключи.
#
# Модель для рассуждений агентов (coordinator, scouts, rover)
MODEL_PROVIDER=sverk
MODEL=gemma4-vlm
SVERK_API_KEY=sk-...
SVERK_API_BASE=https://ai.sverk.tech/v1

# VLM-модель для анализа снимков с дронов (поиск пожара)
MODEL_VISION=gemma4-vlm

# Высота зависания дронов при съёмке (метры)
HOVER_ALTITUDE=2.0

# Ключи других провайдеров
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE=http://host.docker.internal:11434

SCENARIO=city-1
TASK=city_missions

NAV_STEP_SEC=0.15
VIZ_HOST_PORT=8095