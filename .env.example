# .env.example — скопировать в .env и заполнить ключи.
#
# Модель для рассуждений агентов (coordinator, scouts, rover)
MODEL_PROVIDER=sverk
MODEL=gemma4-vlm
SVERK_API_KEY=sk-...
SVERK_API_BASE=https://ai.sverk.tech/v1

# VLM-модель для анализа снимков с дронов (поиск пожара)
# MODEL_VISION — если не задана, используется MODEL (gemma4-vlm)
MODEL_VISION=gemma4-vlm

# Промпт VLM для детекции пожара.
# VLM должна вернуть JSON: {"fire": true|false, "count": N, "confidence": 0.0-1.0}
VLM_FIRE_PROMPT=Ты — детектор пожара на дроне. Смотришь снимок клетки сверху.
  Ответь СТРОГО в формате JSON: {"fire": true|false, "count": число, "confidence": 0.0-1.0}.
  Пожар — это ярко-оранжевый маркер размером ~20см, видимый с высоты.

# Ключи других провайдеров (нужен только тот, что в MODEL_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE=http://host.docker.internal:11434

SCENARIO=city-1
TASK=city_missions

NAV_STEP_SEC=0.15
VIZ_HOST_PORT=8095
