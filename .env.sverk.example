# =============================================================================
# .env.sverk.example — конфигурация для РЕАЛЬНЫХ дронов (make city-sverk)
# =============================================================================
# Скопируй в .env.sverk и заполни IP своих дронов:
#   cp .env.sverk.example .env.sverk
#   nano .env.sverk
#   make city-sverk
# =============================================================================

# =========================== Хосты дронов (Raspberry Pi) =====================
# SSH-доступ по ключу обязателен (ssh-copy-id pi@<ip>)
DRONE1_HOST=192.168.1.10
DRONE2_HOST=192.168.1.11
DRONE3_HOST=192.168.1.12
DRONE4_HOST=192.168.1.13
DRONE_USER=pi
DRONE_REPO_DIR=~/stress_test_drone_city

# =========================== Ровер ===========================================
ROVER_API_URL=http://192.168.1.201:8767

# =========================== LLM (Sverk AI) ==================================
MODEL_PROVIDER=sverk
MODEL=gemma4-vlm
SVERK_API_KEY=sk-...
SVERK_API_BASE=https://ai.sverk.tech/v1

MODEL_VISION=gemma4-vlm

# =========================== Сценарий ========================================
SCENARIO=city-1
TASK=city_missions

# =========================== Параметры поля ===================================
CELL_SIZE_M=0.8
FIELD_ORIGIN_X=-2.0
FIELD_ORIGIN_Y=-2.0
BODY_TAKEOFF=2.0
ARUCO_LOCK_SEC=18
OBSERVER_HOVER_SEC=20

# =========================== Хаб =============================================
# Если coordinator запускается на отдельном ПК (не на дроне):
HUB_URL=http://192.168.1.100:8080
HUB_HOST=192.168.1.100
VIZ_HOST_PORT=8095