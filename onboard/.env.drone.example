# Профиль проекта для дрона — записывается ОДИНАКОВЫМ на все дроны команды.
# docker compose -p $AGENT_ID -f docker-compose.drone.yml --env-file .env.drone up -d

# --- чья это команда и какой флот (несколько команд в одной локальной сети) --
HANDLER_ID=team-7            # идентификатор вашего хендлера (хаба)
FLEET=city                   # city (город дронов / поиск груза) | painter (художники)
HUB_URL=http://10.0.0.2:8080 # центральный хендлер команды (статический IP)
HUB_TOKEN=change-me          # общий секрет команды: чужой хаб дрона не примет

# --- личность борта (можно опустить: возьмётся из сохранённой привязки) -----
#AGENT_ID=drone-3
ROLE=scout                   # scout (city) | painter | rover
#TASK=survey                 # пусто -> из ROLE; painter -> painting

# --- бридж ------------------------------------------------------------------
# dev-мок по умолчанию; на железе — образ поверх вашей sverk-ros2:
#BRIDGE_IMAGE=openclaw-bridge-ros2
#BRIDGE_FRAME=aruco_map
#CELL_SIZE_M=0.8
#FIELD_ORIGIN_X=0.0
#FIELD_ORIGIN_Y=0.0
#FLIGHT_ALT_M=1.5
#ROS2_MCP_URL=http://localhost:9092   # бортовой VLM (ros2_mcp)

# --- мозг ---------------------------------------------------------------------
MODEL_PROVIDER=sverk
SVERK_API_KEY=