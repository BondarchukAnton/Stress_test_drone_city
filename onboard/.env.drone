# ==============================================================
# Профиль дрона — записывается ОДИНАКОВЫМ на все дроны команды.
# Каждый дрон подставляет свой AGENT_ID при запуске.
# ==============================================================

# --- команда и флот ---------------------------------------------------------
HANDLER_ID=team-7
FLEET=city
HUB_URL=http://10.0.0.2:8080
HUB_TOKEN=change-me

# --- личность борта (если не задан — из привязки) ---------------------------
# AGENT_ID=drone-3
ROLE=scout

# --- ArUco / навигация ------------------------------------------------------
BRIDGE_FRAME=aruco_map
CELL_SIZE_M=0.8
FIELD_ORIGIN_X=-2.0        # centre клетки [0,0] в кадре aruco_map
FIELD_ORIGIN_Y=-2.0
FLIGHT_ALT_M=1.5
NAV_SPEED_MS=0.5

# --- поле 6×6: клетки от [0,0] до [5,5] ------------------------------------
# cell_to_m([cx,cy]) → (-2.0 + cx*0.8, -2.0 + cy*0.8)
# Маркеры в центрах клеток:
#   id=62 @ [1,1] = (-1.2,-1.2)    id=51 @ [1,2] = (-1.2,-0.4)
#   id=50 @ [1,4] = (-1.2, 1.2)    id=81 @ [2,1] = (-0.4,-1.2)
#   id=1  @ [2,3] = (-0.4, 0.4)    id=61 @ [3,4] = ( 0.4, 1.2)
#   id=7  @ [4,1] = ( 1.2,-1.2)    id=64 @ [4,2] = ( 1.2,-0.4)
#   id=60 @ [4,4] = ( 1.2, 1.2)

# --- LLM --------------------------------------------------------------------
MODEL_PROVIDER=sverk
MODEL=gemma4-vlm
SVERK_API_KEY=sk-jkx31e2PLKxCpjOynEwyxA
SVERK_API_BASE=https://ai.sverk.tech/v1
MODEL_VISION=gemma4-vlm

# --- VLM: детекция пожара ---------------------------------------------------
VLM_FIRE_PROMPT=Ты — детектор пожара на дроне. Смотришь снимок клетки сверху. Ответь СТРОГО в формате JSON: {"fire": true|false, "count": число объектов огня, "confidence": 0.0-1.0}. fire=true если видишь яркое свечение, дым или открытое пламя в клетке.

# --- ArUco reality-check (опционально) --------------------------------------
# ARUCO_CHECK=1
# ARUCO_OFFX=0
# ARUCO_OFFY=0
# ARUCO_MARKERS=/app/bridge/ros2/markers.txt
