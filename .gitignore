# Ignore VSCode files
.vscode/

# Ignore Python cache files
__pycache__/
*.pyc

# Ignore build and distribution files
build/
dist/
*.egg-info/

# Ignore log files
*.log

# Ignore .env files (but keep .example templates)
.env*
!.env.*.example
*.tmp

# Ignore runtime blackboard
blackboard/

# Ignore aider input history
.aider.input.history

# Ignore all .aider files
.aider/*
.aider*
