# .env.real.example — скопировать в .env.real и указать IP дронов
#
# Использование:
#   cp .env.real.example .env.real
#   ./city_real.sh
#   make city-real

# Провайдер LLM
MODEL_PROVIDER=sverk
MODEL=gemma4-vlm
SVERK_API_KEY=sk-...
SVERK_API_BASE=https://ai.sverk.tech/v1

# VLM для анализа снимков с дронов (поиск пожара)
MODEL_VISION=gemma4-vlm

# Высота зависания дронов при съёмке (метры)
HOVER_ALTITUDE=2.0

SCENARIO=city-1
TASK=city_missions

# === IP дронов ===
DRONE1_URL=http://192.168.1.10:9000
# DRONE2_URL=http://192.168.1.11:9000
# DRONE3_URL=http://192.168.1.12:9000
# DRONE4_URL=http://192.168.1.13:9000
ROVER_URL=http://192.168.1.20:9000

NAV_STEP_SEC=0.15
VIZ_HOST_PORT=8095