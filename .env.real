# .env.real — настройки для реальных дронов.
# Скопировано из .env.real.example. Укажи актуальные IP дронов.

# Провайдер LLM
MODEL_PROVIDER=sverk
MODEL=gemma4-vlm
SVERK_API_KEY=sk-jkx31e2PLKxCpjOynEwyxA
SVERK_API_BASE=https://ai.sverk.tech/v1

# VLM для анализа снимков с дронов (поиск пожара)
MODEL_VISION=gemma4-vlm

# Промпт VLM: опиши как выглядит имитация пожара на твоём полигоне
VLM_FIRE_PROMPT=Ты — детектор пожара на дроне. Смотришь снимок клетки сверху. Ответь СТРОГО в формате JSON: {"fire": true|false, "count": число объектов огня, "confidence": 0.0-1.0}. fire=true если видишь яркое свечение, дым или открытое пламя в клетке. count — сколько отдельных очагов/объектов огня ты видишь. confidence — насколько ты уверен.

SCENARIO=city-1
TASK=city_missions

# DRONE1_URL=http://192.168.1.10:9000
# DRONE2_URL=http://192.168.1.11:9000
# DRONE3_URL=http://192.168.1.12:9000
# DRONE4_URL=http://192.168.1.13:9000
# ROVER_URL=http://192.168.1.20:9000

DRONE1_URL=http://host.docker.internal:9001
DRONE2_URL=http://host.docker.internal:9002
DRONE3_URL=http://host.docker.internal:9003
DRONE4_URL=http://host.docker.internal:9004
ROVER_URL=http://host.docker.internal:9005

NAV_STEP_SEC=0.15
VIZ_HOST_PORT=8095