# =============================================================================
# .env — конфигурация для проекта Drone City
# =============================================================================
# По умолчанию настроено на СИМУЛЯТОР (make city-sverk-sim).
# Для перехода на реальные дроны — см. закомментированные секции внизу.
# =============================================================================

# =========================== РЕЖИМ СИМУЛЯТОРА ================================
# Используется командой: make city-sverk-sim
# Агенты в Docker, ROS2 discovery через host-сеть, все дроны — в симуляторе.

ROS_DOMAIN_ID=0                    # домен ROS2 (должен совпадать с симулятором)

# =========================== LLM (Sverk AI) ==================================
MODEL_PROVIDER=sverk
MODEL=gemma4-vlm
SVERK_API_KEY=sk-jkx31e2PLKxCpjOynEwyxA
SVERK_API_BASE=https://ai.sverk.tech/v1

MODEL_VISION=gemma4-vlm            # VLM для анализа снимков с дронов

# =========================== Сценарий и задача ================================
SCENARIO=city-1
TASK=city_missions

# =========================== Параметры поля (ArUco) ===========================
CELL_SIZE_M=0.8                    # размер одной клетки в метрах
FIELD_ORIGIN_X=-2.0                # смещение поля по X в ArUco-координатах
FIELD_ORIGIN_Y=-2.0                # смещение поля по Y
BODY_TAKEOFF=2.0                   # высота взлёта в body-фрейме (м)
ARUCO_LOCK_SEC=18                  # пауза для захвата ArUco-маркеров (сек)
OBSERVER_HOVER_SEC=20              # зависание observer над home_cell (сек)

# =========================== Ровер ===========================================
# В симуляторе ровер можно не подключать
# ROVER_API_URL=http://192.168.1.201:8767

# =========================== Порты и таймауты =================================
POLL_INTERVAL=1.0                  # интервал опроса blackboard (сек)
BRIDGE_TIMEOUT=120                 # таймаут HTTP к мосту ровера
MODEL_TIMEOUT=45                   # таймаут LLM-вызовов (сек)
VIZ_HOST_PORT=8095                 # порт дэшборда
NAV_STEP_SEC=0.15                  # скорость анимации ровера в моке

# =========================== Настройки чата / демо ============================
STREAM_DELAY=0                     # пауза между кусками стрима мыслей (0=быстро)
MESSAGE_DELAY=0                    # пауза между сообщениями

# =============================================================================
#   ПЕРЕХОД НА РЕАЛЬНЫЕ ДРОНЫ
#
#   Для работы с реальными дронами закомментируй секцию СИМУЛЯТОРА выше,
#   раскомментируй блок ниже и создай .env.sverk (cp .env.sverk.example .env.sverk).
#   Затем: make city-sverk
# =============================================================================

# --- Раскомментировать для реальных дронов ---
# DRONE1_HOST=192.168.1.10
# DRONE2_HOST=192.168.1.11
# DRONE3_HOST=192.168.1.12
# DRONE4_HOST=192.168.1.13
# DRONE_USER=pi
# DRONE_REPO_DIR=~/stress_test_drone_city

# --- Ровер (реальный) ---
# ROVER_API_URL=http://192.168.1.201:8767

# --- Хаб (если coordinator на отдельном ПК) ---
# HUB_URL=http://192.168.1.100:8080
# HUB_HOST=192.168.1.100