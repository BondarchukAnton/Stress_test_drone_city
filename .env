# =============================================================================
# .env — конфигурация Drone City
# =============================================================================
# Активная секция: РЕАЛЬНЫЕ ДРОНЫ (make city-sverk).
# Для симулятора: закомментируй РЕАЛЬНЫЕ, раскомментируй СИМУЛЯТОР.
# Подробнее: Guide.md
# =============================================================================

# =========================== РЕЖИМ СИМУЛЯТОРА (закомментировано) =============
# ROS_DOMAIN_ID=0

# =========================== LLM =============================================
MODEL_PROVIDER=sverk
MODEL=gemma4-vlm
SVERK_API_KEY=sk-jkx31e2PLKxCpjOynEwyxA
SVERK_API_BASE=https://ai.sverk.tech/v1
MODEL_VISION=gemma4-vlm

# =========================== Сценарий ========================================
SCENARIO=city-1
TASK=city_missions

# =========================== Параметры поля ===================================
CELL_SIZE_M=0.8
FIELD_ORIGIN_X=-2.0
FIELD_ORIGIN_Y=-2.0
BODY_TAKEOFF=2.0
ARUCO_LOCK_SEC=18
OBSERVER_HOVER_SEC=20

# =========================== Ровер (реальный) =================================
ROVER_API_URL=http://192.168.1.201:8767

# =========================== Порты ============================================
VIZ_HOST_PORT=8095

# =============================================================================
#   ПЕРЕХОД НА СИМУЛЯТОР
#
#   Закомментируй ROVER_API_URL выше, раскомментируй ROS_DOMAIN_ID.
#   Затем: make city-sverk-sim
# =============================================================================